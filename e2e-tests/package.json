{
  "name": "taskflow-e2e-tests",
  "version": "1.0.0",
  "description": "Playwright E2E automation test suite for TaskFlow",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:rbac": "playwright test --grep @rbac",
    "test:hr": "playwright test --grep @hr",
    "test:sync": "playwright test --grep @sync",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "dotenv": "^16.4.7",
    "mysql2": "^3.12.0"
  }
}
